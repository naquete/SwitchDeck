<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Window" Title="SwitchDeck" Width="1180" Height="760" MinWidth="880" MinHeight="600" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" FontSize="13" Foreground="#F5F6F2" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Border x:Name="Shell" Background="#0A1019" BorderBrush="#344052" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Background="Transparent" Margin="26,0,14,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Grid Width="28" Height="28" Margin="0,0,12,0"><Path Fill="#9FADFF" Data="M1,2 H12 V13 H1 Z M16,2 H27 V13 H16 Z M1,17 H12 V28 H1 Z"/><Path Fill="#65DCAE" Data="M16,17 H27 V28 H16 Z"/></Grid>
    <TextBlock Text="SwitchDeck" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/>
    <Border Background="#1B2533" CornerRadius="4" Margin="12,0,0,0" Padding="7,3" VerticalAlignment="Center"><TextBlock Text="2.0" FontSize="10" Foreground="#8C98A8"/></Border>
    <TextBlock x:Name="DemoBadge" Text="Demonstração" Foreground="#F6C66E" FontSize="12" Margin="18,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="Minimize" Style="{StaticResource Ghost}" Width="40" Height="34" Padding="12" ToolTip="Minimizar" AutomationProperties.Name="Minimizar"><Path Data="M0,5 H12" Stroke="#D3DBE5" StrokeThickness="1.5"/></Button>
    <Button x:Name="Close" Style="{StaticResource Ghost}" Width="40" Height="34" Padding="12" ToolTip="Fechar" AutomationProperties.Name="Fechar"><Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#D3DBE5" StrokeThickness="1.5"/></Button>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" x:Name="MainArea" Margin="30,4,30,18">
   <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="64"/><RowDefinition Height="24"/></Grid.RowDefinitions>
   <Border Background="#131C29" BorderBrush="#263244" BorderThickness="1" CornerRadius="12" Padding="20,15">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Fill="#65DCAE" Width="6" Height="6" Margin="0,0,7,0"/><TextBlock Text="AGORA" FontSize="11" FontWeight="Bold" Foreground="#65DCAE"/></StackPanel><TextBlock Text="no Windows" Foreground="#8C98A8" FontSize="10" Margin="0,5,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center"><TextBlock Text="Som" Foreground="#8C98A8" FontSize="12"/><TextBlock x:Name="StateOutput" Text="Buscando…" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
     <StackPanel Grid.Column="2" Margin="16,0" VerticalAlignment="Center"><TextBlock Text="Voz" Foreground="#8C98A8" FontSize="12"/><TextBlock x:Name="StateComm" Text="Buscando…" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
     <StackPanel Grid.Column="3" Margin="16,0" VerticalAlignment="Center"><TextBlock Text="Microfone" Foreground="#8C98A8" FontSize="12"/><TextBlock x:Name="StateMic" Text="Buscando…" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
     <StackPanel Grid.Column="4" Margin="16,0,0,0" VerticalAlignment="Center"><TextBlock Text="Telas" Foreground="#8C98A8" FontSize="12"/><TextBlock x:Name="StateScreens" Text="Buscando…" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="1"><StackPanel VerticalAlignment="Center"><TextBlock Text="Seu deck" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Um clique. Tudo no lugar." Foreground="#8C98A8" Margin="0,3,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="ButtonCount" Text="" Foreground="#8C98A8" VerticalAlignment="Center" Margin="0,0,20,0"/><Button x:Name="AddTop" Content="+  Novo botão" Style="{StaticResource Primary}"/></StackPanel></Grid>
   <Border Grid.Row="2" x:Name="DeckHousing" Background="#131C29" BorderBrush="#263244" BorderThickness="1" CornerRadius="16" Padding="18,15,12,8">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <ItemsControl x:Name="DeckItems" VerticalAlignment="Top"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="7,2,13,10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
       <Grid><Viewbox Height="164" MaxWidth="164" Stretch="Uniform" StretchDirection="Both"><Grid Width="172" Height="172">
        <Button Tag="run" Padding="5" BorderThickness="2" BorderBrush="{Binding Ring}" Background="#080D15" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Name}"><Button.Content><Grid Width="156" Height="156"><Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel VerticalAlignment="Center" Visibility="{Binding NewVisibility}"><TextBlock Text="+" FontSize="40" Foreground="#9FADFF" HorizontalAlignment="Center" FontWeight="Light"/><TextBlock Text="Novo botão" Foreground="#D3DBE5" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Grid></Button.Content></Button>
        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10" Background="#0A1019" CornerRadius="4" Padding="5,2" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock Text="EM USO" Foreground="{Binding Ring}" FontSize="9" FontWeight="Bold"/></Border>
       </Grid></Viewbox>
       <StackPanel x:Name="TileActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Opacity="0" Visibility="{Binding ActionVisibility}"><Button Tag="edit" Content="Editar" FontSize="11" Padding="10,6"/><Button Tag="menu" Content="···" FontSize="15" Margin="4,0,0,0" Padding="9,4" ToolTip="Mais ações" AutomationProperties.Name="Mais ações"/></StackPanel>
       </Grid>
       <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid><DataTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TileActions" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TileActions" Property="Opacity" Value="1"/></Trigger></DataTemplate.Triggers></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </Border>
   <Border x:Name="EmptyState" Grid.Row="2" Background="#131C29" BorderBrush="#263244" BorderThickness="1" CornerRadius="16" Visibility="Collapsed">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520">
     <Grid Width="124" Height="80" Margin="0,0,0,22"><Border Width="64" Height="64" Background="#202C41" BorderBrush="#9FADFF" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Top"><Path Data="M0,12 C0,-4 24,-4 24,12 M0,12 V23 H6 V12 Z M24,12 V23 H18 V12 Z" Stroke="#9FADFF" StrokeThickness="2.5" Width="27" Height="30" Stretch="Uniform"/></Border><Border Width="64" Height="64" Background="#1B3331" BorderBrush="#65DCAE" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Path Data="M0,0 H28 V19 H0 Z M14,19 V26 M6,26 H22" Stroke="#65DCAE" StrokeThickness="2" Width="30" Height="28" Stretch="Uniform"/></Border></Grid>
     <TextBlock Text="Seu setup, a um botão de distância." FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"/>
     <TextBlock Text="Junte som, microfone e telas em uma tecla.&#10;Depois, troque tudo com um clique." TextAlignment="Center" Foreground="#8C98A8" FontSize="14" LineHeight="23" Margin="0,12,0,22"/>
     <Button x:Name="CreateFirst" Content="Criar meu primeiro botão" Style="{StaticResource Primary}" HorizontalAlignment="Center"/>
     <Button x:Name="CreateStarters" Content="Criar um botão para cada aparelho de som" Style="{StaticResource Ghost}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
    </StackPanel>
   </Border>
   <Grid Grid.Row="3" Margin="4,14,4,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="Seu deck também pode sair daqui." FontWeight="SemiBold"/><TextBlock Text="Ícones, atalhos e seus botões no Ulanzi D200." Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel><Button x:Name="OpenExport" Content="Levar para fora" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   <DockPanel Grid.Row="4" VerticalAlignment="Bottom"><TextBlock x:Name="FooterStatus" Text="Atualizado automaticamente" Style="{StaticResource Hint}"/><TextBlock Text="Clique para ativar · passe o mouse para editar" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></DockPanel>
  </Grid>
  <Border x:Name="Shade" Grid.Row="1" Background="#B000050C" Visibility="Collapsed"/>
  <Border x:Name="Editor" KeyboardNavigation.TabNavigation="Cycle" Grid.Row="1" Width="540" HorizontalAlignment="Right" Background="#131C29" BorderBrush="#364255" BorderThickness="1,1,0,0" Visibility="Collapsed" CornerRadius="16,0,15,0">
   <Border.RenderTransform><TranslateTransform x:Name="EditorSlide"/></Border.RenderTransform>
   <Grid Margin="26,22,26,20"><Grid.RowDefinitions><RowDefinition Height="65"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock x:Name="EditorTitle" Text="O que este botão faz?" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="EditorSubtitle" Text="Combine o que muda com um clique." Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel><Button x:Name="CloseEditor" Content="×" Style="{StaticResource Ghost}" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="23" Padding="8,0" ToolTip="Fechar editor" AutomationProperties.Name="Fechar editor"/></Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
     <StackPanel>
      <Border Background="#1B2533" CornerRadius="9" Padding="13,8" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox x:Name="EnableOutput" Content="Som" VerticalAlignment="Center" Margin="0,0,14,0"/><ComboBox Grid.Column="1" x:Name="OutputChoice" DisplayMemberPath="Short" SelectedValuePath="Name" AutomationProperties.Name="Aparelho de som"/></Grid></Border>
      <Border Background="#1B2533" CornerRadius="9" Padding="13,8" Margin="0,0,0,6"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox x:Name="EnableComm" Content="Voz" VerticalAlignment="Center" Margin="0,0,14,0"/><ComboBox Grid.Column="1" x:Name="CommChoice" DisplayMemberPath="Short" SelectedValuePath="Name" AutomationProperties.Name="Aparelho para chamadas"/></Grid><TextBlock Text="Chamadas e Discord" Style="{StaticResource Hint}" FontSize="11" Margin="0,5,0,0"/><TextBlock x:Name="CommHint" Text="Com o som ligado, a voz acompanha o mesmo aparelho." Style="{StaticResource Hint}" Margin="0,6,0,0" Visibility="Collapsed"/></StackPanel></Border>
      <Border Background="#1B2533" CornerRadius="9" Padding="13,8" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox x:Name="EnableMic" Content="Microfone" VerticalAlignment="Center" Margin="0,0,14,0"/><ComboBox Grid.Column="1" x:Name="MicChoice" DisplayMemberPath="Short" SelectedValuePath="Name" AutomationProperties.Name="Microfone"/></Grid></Border>
      <Border Background="#1B2533" CornerRadius="9" Padding="13,8" Margin="0,0,0,12"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox x:Name="EnableLayout" Content="Telas" VerticalAlignment="Center" Margin="0,0,14,0"/><ComboBox Grid.Column="1" x:Name="LayoutChoice" DisplayMemberPath="Name" SelectedValuePath="Name" AutomationProperties.Name="Arranjo de telas"/></Grid><Button x:Name="CaptureLayout" Content="Guardar o arranjo de agora…" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Padding="0,7,0,0" Foreground="#9FADFF" FontSize="12"/><Grid x:Name="LayoutCapture" Visibility="Collapsed" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="LayoutName" MaxLength="60" ToolTip="Nome do arranjo" AutomationProperties.Name="Nome do arranjo"/><Button x:Name="SaveLayout" Grid.Column="1" Content="Guardar" Margin="8,0,0,0" Padding="10,5"/></Grid></StackPanel></Border>
      <TextBlock Text="Aparência" Style="{StaticResource Section}" Margin="0,0,0,12"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="Nome da tecla" Style="{StaticResource Hint}" Margin="0,0,0,5"/><TextBox x:Name="ButtonName" MaxLength="32" AutomationProperties.Name="Nome da tecla"/><TextBlock Text="Rótulo de cima" Style="{StaticResource Hint}" Margin="0,10,0,5"/><TextBox x:Name="ButtonTop" MaxLength="40" AutomationProperties.Name="Rótulo de cima"/></StackPanel><StackPanel Grid.Column="1"><Border Background="#080D15" CornerRadius="9" Padding="5"><Image x:Name="Preview" Width="108" Height="108" Stretch="Uniform"/></Border><TextBlock Text="Prévia ao vivo" Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Grid>
      <Grid Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="Símbolo" Style="{StaticResource Hint}" Margin="0,0,0,5"/><ComboBox x:Name="GlyphChoice" DisplayMemberPath="Label" SelectedValuePath="Id" AutomationProperties.Name="Símbolo da tecla"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Cor da tecla" Style="{StaticResource Hint}" Margin="0,0,0,7"/><WrapPanel x:Name="ColorChoices"/></StackPanel></Grid>
     </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2"><TextBlock x:Name="EditorError" Foreground="#F6C66E" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/><Border BorderBrush="#2C3849" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,14,0,0"><Grid><StackPanel Orientation="Horizontal"><Button x:Name="SaveButton" Content="Salvar" Style="{StaticResource Primary}" Padding="23,10"/><Button x:Name="TestButton" Content="Testar agora" Margin="8,0,0,0"/><Button x:Name="CancelEditor" Content="Cancelar" Style="{StaticResource Ghost}" Padding="12,10"/></StackPanel><Button x:Name="DeleteEditor" Content="Excluir" Foreground="#FF8277" Style="{StaticResource Ghost}" HorizontalAlignment="Right" Padding="8,10"/></Grid></Border></StackPanel>
   </Grid>
  </Border>
  <Border x:Name="ExportPanel" KeyboardNavigation.TabNavigation="Cycle" Grid.Row="1" Width="620" Background="#131C29" BorderBrush="#364255" BorderThickness="1,1,0,0" CornerRadius="16,0,15,0" HorizontalAlignment="Right" Visibility="Collapsed">
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,22">
    <Grid><TextBlock Text="Levar para fora" FontSize="28" FontWeight="SemiBold"/><Button x:Name="CloseExport" Content="×" Style="{StaticResource Ghost}" FontSize="23" Padding="8,0" HorizontalAlignment="Right" ToolTip="Fechar"/></Grid>
    <TextBlock Text="Seus botões, onde for mais fácil alcançar." Foreground="#8C98A8" Margin="0,8,0,20"/>
    <Border Background="#1B2533" CornerRadius="12" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="Ícones para qualquer deck" Style="{StaticResource Section}"/><TextBlock Text="Salve todas as teclas como imagens PNG. No programa do seu deck, escolha um ícone e cole o comando do botão." Style="{StaticResource Hint}" Margin="0,8,0,16"/><Button x:Name="ExportIcons" Content="Escolher pasta e exportar" HorizontalAlignment="Left"/></StackPanel></Border>
    <Border Background="#1B2533" CornerRadius="12" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="Na área de trabalho" Style="{StaticResource Section}"/><TextBlock Text="Um atalho para cada botão. Clique duas vezes para trocar sua combinação sem abrir o painel." Style="{StaticResource Hint}" Margin="0,8,0,16"/><Button x:Name="ExportShortcuts" Content="Criar todos os atalhos" HorizontalAlignment="Left"/></StackPanel></Border>
    <Border Background="#1B2533" BorderBrush="#3A4262" BorderThickness="1" CornerRadius="12" Padding="18"><StackPanel><DockPanel><Border DockPanel.Dock="Right" Background="#373024" CornerRadius="5" Padding="9,4" HorizontalAlignment="Right"><TextBlock Text="Experimental" Foreground="#F6C66E" FontSize="11"/></Border><TextBlock Text="Ulanzi D200" Style="{StaticResource Section}"/></DockPanel><TextBlock x:Name="UlanziStatus" Text="Verificando instalação…" Margin="0,12,0,0" Foreground="#65DCAE" TextWrapping="Wrap"/><TextBlock x:Name="UlanziDetail" Text="" Style="{StaticResource Hint}" Margin="0,6,0,0"/><TextBlock Text="O programa da Ulanzi será fechado e reaberto." Style="{StaticResource Hint}" Margin="0,12,0,16"/><Button x:Name="SendUlanzi" Content="Enviar para o deck" Style="{StaticResource Primary}" HorizontalAlignment="Left"/></StackPanel></Border>
    <TextBlock Text="Para copiar um comando individual, use o menu da tecla." Style="{StaticResource Hint}" Margin="0,18,0,0"/>
   </StackPanel></ScrollViewer>
  </Border>
  <Border x:Name="ConfirmShade" KeyboardNavigation.TabNavigation="Cycle" Grid.RowSpan="2" Background="#CC050911" Visibility="Collapsed"><Border Width="440" Background="#1B2533" BorderBrush="#465470" BorderThickness="1" CornerRadius="16" Padding="28" VerticalAlignment="Center"><StackPanel><TextBlock x:Name="ConfirmTitle" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ConfirmBody" Foreground="#D3DBE5" TextWrapping="Wrap" LineHeight="22" Margin="0,14,0,24"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ConfirmCancel" Content="Cancelar" Style="{StaticResource Ghost}" Margin="0,0,8,0"/><Button x:Name="ConfirmAccept" Content="Continuar" Style="{StaticResource Primary}"/></StackPanel></StackPanel></Border></Border>
  <Border x:Name="BusyShade" Grid.RowSpan="2" Background="#DD0A1019" Visibility="Collapsed"><StackPanel Width="350" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="BusyText" Text="Buscando seus aparelhos…" FontSize="20" TextAlignment="Center" TextWrapping="Wrap"/><ProgressBar IsIndeterminate="True" Height="3" Margin="0,24,0,0" Foreground="#9FADFF" Background="#252C36" BorderThickness="0"/></StackPanel></Border>
  <Border x:Name="Toast" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,28" MaxWidth="680" Background="#22382F" BorderBrush="#65DCAE" BorderThickness="1" CornerRadius="10" Padding="18,13" Visibility="Collapsed"><TextBlock x:Name="ToastText" TextWrapping="Wrap" Foreground="#F5F6F2" FontSize="13"/></Border>
 </Grid></Border>
</Window>
